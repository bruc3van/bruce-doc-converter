{
  "name": "bruce-doc-converter-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle that exposes the bdc document converter to the agent as tools (doc_convert, doc_batch, doc_setup).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "document",
    "converter",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "markdown"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "author": "bruc3van",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruc3van/bruce-doc-converter.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/bruc3van/bruce-doc-converter#readme",
  "bugs": {
    "url": "https://github.com/bruc3van/bruce-doc-converter/issues"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": ">=0.1.5-rc.1 <0.2.0 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0 || >=0.1.6-alpha.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
